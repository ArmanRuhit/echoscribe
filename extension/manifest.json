{
    "manifest_version": 3,
    "name": "EchoScribe",
    "version": "0.3.0",
    "description": "Live-transcribe the audio of a course video playing in this tab.",
    "minimum_chrome_version": "116",
    "permissions": ["activeTab", "tabCapture", "offscreen", "sidePanel", "storage", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "EchoScribe: start live transcript"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765"
    }
}