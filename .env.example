# EchoScribe server config. Copy to .env and edit.
# Shell variables win; this file only fills what is unset.

# Model. English-only: tiny.en, base.en, small.en, medium.en, distil-large-v3.
# Multilingual: tiny, base, small, medium, large-v3, large-v3-turbo.
# large-v3 is the accuracy ceiling and still runs real time on cuda.
ECHOSCRIBE_MODEL=small.en

# Fallback language when the panel sends none: en, hi, auto.
# auto lets Whisper detect; the panel selection always overrides this.
ECHOSCRIBE_LANGUAGE=en

# Device: cpu, cuda. cuda needs the CUDA 12 wheels from requirements.txt.
# Leave commented so the server default (cpu) applies.
#ECHOSCRIBE_DEVICE=cpu

# Precision. cpu: int8, int8_float32, float32.
#            cuda: float16, bfloat16, int8_float16, int8_bfloat16.
# Leave unset to follow the device (int8 on cpu, float16 on cuda).
#ECHOSCRIBE_COMPUTE=int8

# Any writable directory; transcripts go to <dir>/transcripts/.
ECHOSCRIBE_DIR=~/EchoScribe

# Free TCP port on 127.0.0.1, 1024-65535. Must match the extension's connect-src.
ECHOSCRIBE_PORT=8765

# Domain words Whisper mishears, one line, under ~200 chars.
# Example: BODMAS, JSON, system prompt, node, chain of thought
# Example: The lecture covers LLMs, prompts, chain of thought, BODMAS, JSON, system prompt, and node.
#ECHOSCRIBE_PROMPT=

# Model cache directory; defaults to ~/.cache/huggingface.
# HF_HOME=/desk/models/hf
