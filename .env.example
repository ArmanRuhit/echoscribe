# EchoScribe server config. Copy to .env and edit.
# Shell variables win; this file only fills what is unset.

# Model. small.en is English-only; use small or medium for Hindi.
ECHOSCRIBE_MODEL=small.en

# Fallback language when the panel sends none: en, hi, or auto.
ECHOSCRIBE_LANGUAGE=en

# cpu or cuda. cuda is not wired yet: CTranslate2 4.8.5 needs CUDA 12 libs.
ECHOSCRIBE_DEVICE=cpu

# int8 on CPU, float16 on GPU.
ECHOSCRIBE_COMPUTE=int8

# Transcripts land in <dir>/transcripts/.
ECHOSCRIBE_DIR=~/EchoScribe

# Must match the extension's connect-src.
ECHOSCRIBE_PORT=8765

# Model cache. Uncomment to keep models off the home partition.
# HF_HOME=/desk/models/hf
